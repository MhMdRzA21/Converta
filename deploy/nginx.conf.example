# نمونه پیکربندی nginx برای قرار دادن جلوی سرور Node
# جایگزین کن: yourdomain.com

server {
    listen 80;
    server_name yourdomain.com www.yourdomain.com;

    client_max_body_size 30m;   # باید هم‌راستا با محدودیت multer در server/routes/convert.js باشه

    location / {
        proxy_pass http://127.0.0.1:3000;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 120s;   # تبدیل فایل‌های بزرگ ممکنه طول بکشه
    }
}

# بعد از گرفتن SSL با certbot، nginx خودش این بلاک رو به HTTPS ریدایرکت می‌کنه
